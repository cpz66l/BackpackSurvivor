--- !u!114 &864857651
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 864857649}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u6B22\u8FCE\u6765\u5230\u300A\u80CC\u5305\u5E78\u5B58\u8005\u300B\u3002\r\n\r\n\u8FD9\u662F\u4E00\u6B3E\u201C\u8FB9\u6218\u6597\u3001\u8FB9\u6574\u7406\u80CC\u5305\u3001\u8FB9\u6784\u7B51\u6B66\u5668\u7EC4\u5408\u201D\u7684\u5E78\u5B58\u8005
    Demo\u3002\r\n\u4F60\u7684\u76EE\u6807\u5F88\u7B80\u5355\uFF1A\u5728\u8D8A\u6765\u8D8A\u5F3A\u7684\u654C\u6F6E\u4E2D\u6D3B\u5230\u6700\u540E\uFF0C\u5E76\u5C3D\u53EF\u80FD\u641C\u522E\u66F4\u9AD8\u4EF7\u503C\u7684\u88C5\u5907\u3002\r\n\r\n\u57FA\u7840\u64CD\u4F5C\uFF1A\nWASD\uFF1A\u79FB\u52A8\n\u9F20\u6807\uFF1A\u7784\u51C6\u65B9\u5411\n\u5DE6\u952E\uFF1A\u4E3B\u52A8\u5C04\u51FB\nE\uFF1A\u62FE\u53D6\u9644\u8FD1\u88C5\u5907
    / \u6253\u5F00\u5B9D\u7BB1\nR\uFF1A\u65CB\u8F6C\u6B63\u5728\u62D6\u62FD\u7684\u7269\u54C1\nTab\uFF1A\u6253\u5F00
    / \u5173\u95ED\u80CC\u5305\nEsc\uFF1A\u6682\u505C / \u7EE7\u7EED\u6E38\u620F\n\n\u6838\u5FC3\u76EE\u6807\uFF1A\n\u5728\u654C\u4EBA\u8FFD\u51FB\u548C\u8FDC\u7A0B\u706B\u529B\u538B\u529B\u4E0B\uFF0C\u5C3D\u91CF\u751F\u5B58\u5230\u6700\u540E\uFF0C\u5E76\u5E26\u51FA\u66F4\u9AD8\u4EF7\u503C\u7684\u80CC\u5305\u7269\u54C1\u3001\u91D1\u5E01\u548C\u4F20\u8BF4\u88C5\u5907\u3002\n\n\u80CC\u5305\u7CFB\u7EDF\uFF1A\n\u88C5\u5907\u9700\u8981\u653E\u5165\u80CC\u5305\u683C\u5B50\u4E2D\u3002\u4E0D\u540C\u7269\u54C1\u5360\u7528\u4E0D\u540C\u5927\u5C0F\uFF0C\u53EF\u4EE5\u65CB\u8F6C\u6446\u653E\u3002\n\u540C\u540D\u540C\u7B49\u7EA7\u7269\u54C1\u53EF\u4EE5\u5408\u6210\u5347\u7EA7\uFF0C\u5347\u7EA7\u540E\u4F1A\u63D0\u9AD8\u7269\u54C1\u4EF7\u503C\u6216\u6548\u679C\u5F3A\u5EA6\u3002\n\u80CC\u5305\u4E2D\u7684\u6B66\u5668\u4F1A\u81EA\u52A8\u6FC0\u6D3B\u4E3A\u73A9\u5BB6\u8EAB\u8FB9\u7684\u81EA\u52A8\u6B66\u5668\uFF0C\u4F46\u6FC0\u6D3B\u6570\u91CF\u6709\u9650\uFF0C\u9700\u8981\u5408\u7406\u5B89\u6392\u4F4D\u7F6E\u548C\u9009\u62E9\u3002\n\n\u6B66\u5668\u6FC0\u6D3B\uFF1A\n\u80CC\u5305\u4F4D\u7F6E\u4F1A\u5F71\u54CD\u6B66\u5668\u6FC0\u6D3B\u4F18\u5148\u7EA7\uFF0C\u8D8A\u9760\u5DE6\u4E0A\u8D8A\u4F18\u5148\u3002\n\u90E8\u5206\u7269\u54C1\u6216\u6548\u679C\u53EF\u4EE5\u63D0\u9AD8\u6B66\u5668\u6FC0\u6D3B\u4E0A\u9650\u3002\n\u6B66\u5668\u7684\u7C7B\u578B\u3001\u54C1\u8D28\u548C\u7B49\u7EA7\u4F1A\u5F71\u54CD\u6700\u7EC8\u4F24\u5BB3\u3002\n\n\u90BB\u63A5\u6548\u679C\uFF1A\n\u90E8\u5206\u7269\u54C1\u8FB9\u7F18\u5E26\u6709\u53EF\u8FDE\u63A5\u63A5\u53E3\u3002\n\u5F53\u7B26\u5408\u89C4\u5219\u7684\u7269\u54C1\u4EE5\u6B63\u786E\u65B9\u5411\u76F8\u90BB\u65F6\uFF0C\u4F1A\u89E6\u53D1\u90BB\u63A5\u6548\u679C\u3002\n\u7070\u8272\u63A5\u53E3\u8868\u793A\u53EF\u8FDE\u63A5\u65B9\u5411\uFF0C\u91D1\u8272\u63A5\u53E3\u8868\u793A\u5F53\u524D\u5DF2\u89E6\u53D1\u6709\u6548\u6548\u679C\u3002\n\u4E0D\u662F\u6240\u6709\u65B9\u5411\u90FD\u80FD\u8FDE\u63A5\uFF0C\u65CB\u8F6C\u7269\u54C1\u4F1A\u6539\u53D8\u63A5\u53E3\u65B9\u5411\u3002\n\n\u5347\u7EA7\u9009\u62E9\uFF1A\n\u5347\u7EA7\u65F6\u4F1A\u6682\u505C\u6218\u6597\u5E76\u51FA\u73B0\u4E09\u9009\u4E00\u3002\n\u5347\u7EA7\u6548\u679C\u5305\u542B\u4F24\u5BB3\u3001\u5C04\u901F\u3001\u751F\u5B58\u3001\u62FE\u53D6\u3001\u91D1\u5E01\u548C\u6784\u7B51\u80FD\u529B\u7B49\u65B9\u5411\u3002\n\u4E0D\u540C\u9009\u62E9\u4F1A\u5F71\u54CD\u4F60\u7684\u6218\u6597\u65B9\u5F0F\u548C\u641C\u522E\u6548\u7387\u3002\n\n\u6389\u843D\u4E0E\u5B9D\u7BB1\uFF1A\n\u654C\u4EBA\u4F1A\u6389\u843D\u7ECF\u9A8C\u3001\u91D1\u5E01\u6216\u88C5\u5907\u3002\n\u5B9D\u7BB1\u4F1A\u63D0\u4F9B\u66F4\u9AD8\u4EF7\u503C\u7684\u7269\u54C1\uFF0C\u8D8A\u5230\u540E\u671F\u8D8A\u6709\u673A\u4F1A\u83B7\u5F97\u9AD8\u54C1\u8D28\u5956\u52B1\u3002\n\u754C\u9762\u4F1A\u663E\u793A\u6700\u8FD1\u5B9D\u7BB1\u8DDD\u79BB\uFF0C\u4F60\u53EF\u4EE5\u5728\u6218\u6597\u7A7A\u9699\u4E2D\u51B3\u5B9A\u662F\u5426\u5192\u9669\u524D\u5F80\u3002\n\n\u654C\u4EBA\uFF1A\n\u666E\u901A\u654C\u4EBA\u4F1A\u6301\u7EED\u8FFD\u51FB\u73A9\u5BB6\u3002\n\u7CBE\u82F1\u654C\u4EBA\u66F4\u8010\u6253\uFF0C\u4F46\u6389\u843D\u66F4\u597D\u3002\n\u8FDC\u7A0B\u654C\u4EBA\u4F1A\u4FDD\u6301\u8DDD\u79BB\u5E76\u53D1\u5C04\u5B50\u5F39\uFF0C\u540E\u671F\u4F1A\u589E\u52A0\u8D70\u4F4D\u538B\u529B\u3002\n\u4E0D\u8981\u53EA\u987E\u6574\u7406\u80CC\u5305\uFF0C\u654C\u4EBA\u4ECD\u7136\u4F1A\u5728\u6B64\u65F6\u903C\u8FD1\u3002\n\n\u80DC\u5229\u4E0E\u8BB0\u5F55\uFF1A\n\u80DC\u5229\u540E\u4F1A\u5C06\u672C\u5C40\u5E26\u51FA\u7684\u6536\u76CA\u8BA1\u5165\u5C40\u5916\u8BB0\u5F55\u3002\n\u5F53\u524D\u8BB0\u5F55\u5305\u62EC\u603B\u5F00\u5C40\u3001\u80DC\u5229\u6B21\u6570\u3001\u6700\u9AD8\u80CC\u5305\u4EF7\u503C\u3001\u5C40\u5916\u91D1\u5E01\u3001\u4F20\u8BF4\u7269\u54C1\u5E26\u51FA\u6570\u548C\u4F20\u8BF4\u7269\u54C1\u7D2F\u8BA1\u4EF7\u503C\u3002\n\u5931\u8D25\u53EA\u8BB0\u5F55\u5F00\u5C40\u6B21\u6570\uFF0C\u4E0D\u4F1A\u5E26\u51FA\u91D1\u5E01\u548C\u4F20\u8BF4\u6536\u76CA\u3002\n\n\u63D0\u793A\uFF1A\n\u4E0D\u8981\u76F2\u76EE\u8FFD\u6C42\u5355\u4E2A\u9AD8\u7B49\u7EA7\u7269\u54C1\uFF0C\u6FC0\u6D3B\u4E0A\u9650\u3001\u90BB\u63A5\u6548\u679C\u3001\u80CC\u5305\u7A7A\u95F4\u548C\u6B66\u5668\u7C7B\u578B\u540C\u6837\u91CD\u8981\u3002\n\u6218\u6597\u5F3A\u5EA6\u4F1A\u968F\u65F6\u95F4\u4E0A\u5347\uFF0C\u9002\u65F6\u6574\u7406\u80CC\u5305\u6BD4\u4E34\u573A\u4E71\u62D6\u66F4\u5B89\u5168\u3002\n\u9AD8\u4EF7\u503C\u5B9D\u7BB1\u503C\u5F97\u5192\u9669\uFF0C\u4F46\u522B\u5728\u654C\u6F6E\u5305\u56F4\u65F6\u8D2A\u3002"
