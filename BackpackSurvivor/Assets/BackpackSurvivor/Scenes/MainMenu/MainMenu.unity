  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u6B22\u8FCE\u6765\u5230\u300A\u80CC\u5305\u5E78\u5B58\u8005\u300B\u3002\r\n\r\n\u8FD9\u662F\u4E00\u6B3E\u201C\u8FB9\u6218\u6597\u3001\u8FB9\u6574\u7406\u80CC\u5305\u3001\u8FB9\u6784\u7B51\u6B66\u5668\u7EC4\u5408\u201D\u7684\u5E78\u5B58\u8005
    Demo\u3002\r\n\u4F60\u7684\u76EE\u6807\u5F88\u7B80\u5355\uFF1A\u5728\u8D8A\u6765\u8D8A\u5F3A\u7684\u654C\u6F6E\u4E2D\u6D3B\u5230\u6700\u540E\uFF0C\u5E76\u5C3D\u53EF\u80FD\u641C\u522E\u66F4\u9AD8\u4EF7\u503C\u7684\u88C5\u5907\u3002\r\n\r\n\u4E00\u3001\u57FA\u7840\u64CD\u4F5C\r\n\r\n\u79FB\u52A8\uFF1AW
    / A / S / D\r\n\u7784\u51C6\uFF1A\u9F20\u6807\u6307\u5411\r\n\u4EA4\u4E92\uFF1AE\r\n\u6253\u5F00
    / \u5173\u95ED\u80CC\u5305\uFF1ATab\r\n\u65CB\u8F6C\u7269\u54C1\uFF1A\u62D6\u62FD\u7269\u54C1\u65F6\u6309
    R\r\n\r\n\u9760\u8FD1\u5730\u4E0A\u7684\u88C5\u5907\u6216\u5B9D\u7BB1\u65F6\uFF0C\u6309
    E \u53EF\u4EE5\u62FE\u53D6\u6216\u5F00\u542F\u3002\r\n\u7ECF\u9A8C\u548C\u91D1\u5E01\u4F1A\u81EA\u52A8\u5438\u9644\uFF0C\u88C5\u5907\u9700\u8981\u4F60\u624B\u52A8\u62FE\u53D6\u5E76\u653E\u5165\u80CC\u5305\u3002\r\n\r\n\u4E8C\u3001\u6B66\u5668\u4E0D\u662F\u653E\u7740\u770B\u7684\r\n\r\n\u80CC\u5305\u91CC\u7684\u6B66\u5668\u4F1A\u5728\u89D2\u8272\u8EAB\u8FB9\u751F\u6210\u5BF9\u5E94\u7684\u81EA\u52A8\u6B66\u5668\u3002\r\n\r\n\u4F8B\u5982\uFF1A\r\n\u628A\u624B\u67AA\u653E\u8FDB\u80CC\u5305\uFF0C\u89D2\u8272\u8EAB\u8FB9\u4F1A\u51FA\u73B0\u81EA\u52A8\u624B\u67AA\u3002\r\n\u628A\u6B65\u67AA\u653E\u8FDB\u80CC\u5305\uFF0C\u89D2\u8272\u8EAB\u8FB9\u4F1A\u51FA\u73B0\u81EA\u52A8\u6B65\u67AA\u3002\r\n\u628A\u9730\u5F39\u67AA\u653E\u8FDB\u80CC\u5305\uFF0C\u89D2\u8272\u8EAB\u8FB9\u4F1A\u51FA\u73B0\u81EA\u52A8\u9730\u5F39\u67AA\u3002\r\n\r\n\u9ED8\u8BA4\u60C5\u51B5\u4E0B\uFF0C\u89D2\u8272\u53EA\u80FD\u6FC0\u6D3B\u6709\u9650\u6570\u91CF\u7684\u81EA\u52A8\u6B66\u5668\u3002\r\n\u5982\u679C\u80CC\u5305\u91CC\u6709\u591A\u628A\u6B66\u5668\uFF0C\u7CFB\u7EDF\u4F1A\u4F18\u5148\u6FC0\u6D3B\u80CC\u5305\u4E2D\u66F4\u9760\u5DE6\u4E0A\u4F4D\u7F6E\u7684\u6B66\u5668\u3002\r\n\r\n\u7B80\u5355\u7406\u89E3\uFF1A\r\n\u8D8A\u9760\u5DE6\u3001\u8D8A\u9760\u4E0A\uFF0C\u4F18\u5148\u7EA7\u8D8A\u9AD8\u3002\r\n\r\n\u6240\u4EE5\u80CC\u5305\u4F4D\u7F6E\u4E0D\u53EA\u662F\u6536\u7EB3\u7A7A\u95F4\uFF0C\u4E5F\u4F1A\u5F71\u54CD\u6218\u6597\u9009\u62E9\u3002\r\n\r\n\u4E09\u3001\u5408\u5E76\u5347\u7EA7\r\n\r\n\u4E24\u4E2A\u540C\u540D\u3001\u540C\u7B49\u7EA7\u7684\u7269\u54C1\u53EF\u4EE5\u5408\u5E76\u6210\u66F4\u9AD8\u7B49\u7EA7\u3002\r\n\r\n\u4F8B\u5982\uFF1A\r\nLv.1
    \u624B\u67AA + Lv.1 \u624B\u67AA = Lv.2 \u624B\u67AA\r\n\r\n\u5347\u7EA7\u540E\u7684\u7269\u54C1\u4F1A\u83B7\u5F97\u66F4\u9AD8\u4EF7\u503C\u6216\u66F4\u5F3A\u6548\u679C\u3002\r\n\u6B66\u5668\u5347\u7EA7\u540E\uFF0C\u4F24\u5BB3\u4F1A\u63D0\u5347\u3002\r\n\u82AF\u7247\u5347\u7EA7\u540E\uFF0C\u52A0\u6210\u6548\u679C\u4F1A\u63D0\u5347\u3002\r\n\r\n\u4F46\u5408\u5E76\u4E5F\u4F1A\u6539\u53D8\u80CC\u5305\u7A7A\u95F4\u5E03\u5C40\u3002\r\n\u6709\u65F6\u5019\u4FDD\u7559\u4E24\u4E2A\u4F4E\u7EA7\u7269\u54C1\uFF0C\u4E5F\u53EF\u80FD\u6BD4\u7ACB\u523B\u5408\u6210\u66F4\u9002\u5408\u5F53\u524D\u6784\u7B51\u3002\r\n\r\n\u56DB\u3001\u90BB\u63A5\u642D\u914D\uFF1A\u8FD9\u624D\u662F\u80CC\u5305\u6DF1\u5EA6\r\n\r\n\u90E8\u5206\u7269\u54C1\u8FB9\u7F18\u4F1A\u51FA\u73B0\u201C\u63A5\u53E3\u8FB9\u201D\u3002\r\n\r\n\u7070\u8272\u8FB9\uFF1A\u8FD9\u4E2A\u65B9\u5411\u53EF\u4EE5\u8FDE\u63A5\u3002\r\n\u91D1\u8272\u8FB9\uFF1A\u8FD9\u4E2A\u8FDE\u63A5\u5DF2\u7ECF\u751F\u6548\u3002\r\n\r\n\u628A\u5408\u9002\u7684\u7269\u54C1\u6309\u6B63\u786E\u65B9\u5411\u8D34\u5728\u4E00\u8D77\uFF0C\u5C31\u80FD\u89E6\u53D1\u90BB\u63A5\u6548\u679C\u3002\r\n\r\n\u76EE\u524D\u6700\u91CD\u8981\u7684\u4F8B\u5B50\uFF1A\r\n\r\n\u53CC\u6301\u624B\u67AA\uFF1A\r\n\u4E24\u628A\u624B\u67AA\u5DE6\u53F3\u76F8\u90BB\u65F6\uFF0C\u53EF\u4EE5\u89E6\u53D1\u201C\u53CC\u6301\u201D\u6548\u679C\uFF0C\u8BA9\u7B2C\u4E8C\u628A\u624B\u67AA\u4E5F\u53C2\u4E0E\u81EA\u52A8\u653B\u51FB\u3002\r\n\r\n\u5F39\u5323\u82AF\u7247\uFF1A\r\n\u628A\u5F39\u5323\u7C7B\u82AF\u7247\u63A5\u5728\u6307\u5B9A\u6B66\u5668\u65C1\u8FB9\uFF0C\u53EF\u4EE5\u63D0\u5347\u6B66\u5668\u653B\u901F\u3002\r\n\r\n\u653B\u51FB\u82AF\u7247\uFF1A\r\n\u628A\u653B\u51FB\u82AF\u7247\u63A5\u5728\u6307\u5B9A\u6B66\u5668\u65C1\u8FB9\uFF0C\u53EF\u4EE5\u63D0\u5347\u6B66\u5668\u4F24\u5BB3\u3002\r\n\r\n\u6CE8\u610F\uFF1A\r\n\u4E0D\u662F\u6240\u6709\u65B9\u5411\u90FD\u80FD\u89E6\u53D1\u8FDE\u63A5\u3002\r\n\u4E0D\u662F\u6240\u6709\u7269\u54C1\u90FD\u80FD\u548C\u6240\u6709\u7269\u54C1\u642D\u914D\u3002\r\n\u770B\u7070\u8272\u63A5\u53E3\u8FB9\uFF0C\u627E\u80FD\u63A5\u7684\u4F4D\u7F6E\uFF1B\u770B\u91D1\u8272\u63A5\u53E3\u8FB9\uFF0C\u786E\u8BA4\u6548\u679C\u5DF2\u7ECF\u751F\u6548\u3002\r\n\r\n\u4E94\u3001\u7B2C\u4E00\u5C40\u63A8\u8350\u73A9\u6CD5\r\n\r\n\u5982\u679C\u4F60\u662F\u7B2C\u4E00\u6B21\u73A9\uFF0C\u53EF\u4EE5\u6309\u8FD9\u4E2A\u601D\u8DEF\uFF1A\r\n\r\n1.
    \u5148\u6361\u5230\u4EFB\u610F\u4E00\u628A\u6B66\u5668\uFF0C\u653E\u8FDB\u80CC\u5305\uFF0C\u8BA9\u81EA\u52A8\u6B66\u5668\u542F\u52A8\u3002\r\n2.
    \u770B\u5230\u5B9D\u7BB1\u8DDD\u79BB\u63D0\u793A\u65F6\uFF0C\u4F18\u5148\u53BB\u627E\u5B9D\u7BB1\u3002\r\n3.
    \u6361\u5230\u7B2C\u4E8C\u628A\u624B\u67AA\u65F6\uFF0C\u5C1D\u8BD5\u628A\u4E24\u628A\u624B\u67AA\u5DE6\u53F3\u8D34\u5728\u4E00\u8D77\u3002\r\n4.
    \u770B\u5230\u5F39\u5323\u6216\u653B\u51FB\u82AF\u7247\u65F6\uFF0C\u89C2\u5BDF\u5B83\u7684\u63A5\u53E3\u8FB9\uFF0C\u5C1D\u8BD5\u63A5\u5230\u6B66\u5668\u65C1\u8FB9\u3002\r\n5.
    \u80CC\u5305\u6EE1\u4E86\u4E0D\u8981\u614C\uFF0C\u6253\u5F00\u80CC\u5305\u6574\u7406\u3001\u65CB\u8F6C\u3001\u5408\u5E76\uFF0C\u518D\u7EE7\u7EED\u6218\u6597\u3002\r\n\r\n\u516D\u3001\u80DC\u5229\u5173\u952E\r\n\r\n\u6D3B\u4E0B\u53BB\u4E0D\u53EA\u9760\u8D70\u4F4D\uFF0C\u4E5F\u9760\u6574\u7406\u80CC\u5305\u3002\r\n\r\n\u4F60\u9700\u8981\u5728\u6218\u6597\u7A7A\u6863\u5FEB\u901F\u5224\u65AD\uFF1A\r\n\u54EA\u628A\u6B66\u5668\u5E94\u8BE5\u653E\u5728\u5DE6\u4E0A\u4F18\u5148\u6FC0\u6D3B\uFF1F\r\n\u54EA\u4E9B\u7269\u54C1\u503C\u5F97\u5408\u5E76\u5347\u7EA7\uFF1F\r\n\u54EA\u4E9B\u82AF\u7247\u5E94\u8BE5\u8D34\u5728\u6B66\u5668\u65C1\u8FB9\uFF1F\r\n\u4E3A\u4E86\u89E6\u53D1\u90BB\u63A5\u6548\u679C\uFF0C\u503C\u4E0D\u503C\u5F97\u727A\u7272\u4E00\u70B9\u80CC\u5305\u7A7A\u95F4\uFF1F\r\n\r\n\u771F\u6B63\u5F3A\u7684\u6784\u7B51\uFF0C\u5F80\u5F80\u4E0D\u662F\u5355\u4EF6\u88C5\u5907\u6700\u5F3A\uFF0C\r\n\u800C\u662F\u6B66\u5668\u3001\u7B49\u7EA7\u3001\u7A00\u6709\u5EA6\u3001\u82AF\u7247\u548C\u80CC\u5305\u4F4D\u7F6E\u4E00\u8D77\u914D\u5408\u3002\r\n\r\n\u795D\u4F60\u6491\u8FC7\u8FD9
