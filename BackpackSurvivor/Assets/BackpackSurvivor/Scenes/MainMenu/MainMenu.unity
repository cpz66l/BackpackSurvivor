  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u672C Demo \u4E3A\u4E2A\u4EBA\u5B66\u4E60\u4E0E\u6C42\u804C\u5C55\u793A\u9879\u76EE\uFF0C\u5F00\u53D1\u76EE\u6807\u662F\u9A8C\u8BC1\u201C\u5E78\u5B58\u8005\u6218\u6597
    + \u80CC\u5305\u6784\u7B51 + \u641C\u522E\u6210\u957F\u201D\u7684\u6838\u5FC3\u73A9\u6CD5\u95ED\u73AF\u3002\n\n\u5F00\u53D1\u8005\uFF1Acpz66l\r\n\u5F00\u53D1\u5468\u671F\uFF1A2026.07.19
    \u8D77\r\n\n\u5F53\u524D\u7248\u672CV0.2\u5185\u5BB9\uFF1A\n15 \u5206\u949F\u5355\u5C40\u751F\u5B58\u6D41\u7A0B\n\u81EA\u52A8\u6B66\u5668\u4E0E\u80CC\u5305\u6B66\u5668\u6FC0\u6D3B\n\u6389\u843D\u3001\u62FE\u53D6\u3001\u5B9D\u7BB1\u4E0E\u80CC\u5305\u6574\u7406\n\u5408\u5E76\u5347\u7EA7\u3001\u90BB\u63A5\u8054\u52A8\u4E0E\u82AF\u7247\u52A0\u6210\n\u7ECF\u9A8C\u5347\u7EA7\u3001\u6CE2\u6B21\u538B\u529B\u3001\u7CBE\u82F1\u654C\u4EBA\u4E0E\u7ED3\u7B97\u6D41\u7A0B\n\n\u5F00\u53D1\u8BF4\u660E\uFF1A\n\u672C\u9879\u76EE\u7531\u4E2A\u4EBA\u72EC\u7ACB\u5F00\u53D1\uFF0C\u4E3B\u8981\u7528\u4E8E\u5C55\u793A
    Unity \u6E38\u620F\u5F00\u53D1\u3001\u73A9\u6CD5\u7CFB\u7EDF\u62C6\u89E3\u3001UI
    \u4EA4\u4E92\u3001\u5BF9\u8C61\u6C60\u3001\u6389\u843D\u7CFB\u7EDF\u3001\u6218\u6597\u53CD\u9988\u4E0E
    Demo \u95ED\u73AF\u80FD\u529B\u3002\n\n\u5F53\u524D\u4ECD\u4E3A\u5F00\u53D1\u4E2D\u7248\u672C\uFF0C\u6570\u503C\u5E73\u8861\u3001\u7F8E\u672F\u8868\u73B0\u3001\u97F3\u6548\u6DF7\u97F3\u548C\u5185\u5BB9\u4E30\u5BCC\u5EA6\u4ECD\u4F1A\u7EE7\u7EED\u8FED\u4EE3\u3002\n\n\u7D20\u6750\u8BF4\u660E\uFF1A\n\u9879\u76EE\u4E2D\u7684\u90E8\u5206\u5B57\u4F53\u3001\u56FE\u7247\u3001\u6A21\u578B\u6216\u97F3\u6548\u8D44\u6E90\u53EF\u80FD\u6765\u81EA\u5B66\u4E60\u7D20\u6750\u3001\u5F00\u6E90\u8D44\u6E90\u6216\u4E34\u65F6\u5360\u4F4D\u8D44\u6E90\uFF0C\u4EC5\u7528\u4E8E\u4E2A\u4EBA\u5B66\u4E60\u4E0E\u4F5C\u54C1\u96C6\u5C55\u793A\uFF0C\u4E0D\u7528\u4E8E\u5546\u4E1A\u53D1\u5E03\u3002\n\n\u611F\u8C22\u8BD5\u73A9\u4E0E\u53CD\u9988!!!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8b210c15051bd8c4b9658f6b60875a89, type: 2}
