  {
    "path": "Canvas/GameplayGuidePanel/Scroll View/Viewport/Content/BodyText",
    "active": true,
    "rect": "(x:-513.60, y:-1793.76, width:1027.21, height:3587.51)",
    "pos": "(513.60, -1793.76)",
    "components": [
